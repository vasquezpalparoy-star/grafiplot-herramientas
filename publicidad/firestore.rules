rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() {
   return request.auth != null && request.auth.token.email == 'grafiplotvasquez@gmail.com' && request.auth.token.email_verified == true;
  }
  function validAd() {
   let d = request.resource.data;
   return d.keys().hasAll(['title','body','style','target','imageUrl','createdAt','authorUid'])
    && d.keys().hasOnly(['title','body','style','target','imageUrl','createdAt','authorUid'])
    && d.title is string && d.title.size() > 0 && d.title.size() <= 80
    && d.body is string && d.body.size() > 0 && d.body.size() <= 1000
    && d.style in ['aviso','promocion','importante','imagen']
    && d.target in ['inicio','caratulas','fut','impresion','pagina-web']
    && d.imageUrl is string && d.imageUrl.size() <= 1500
    && (d.imageUrl == '' || d.imageUrl.matches('https://.*'))
    && (d.style != 'imagen' || d.imageUrl.matches('https://.+'))
    && d.createdAt is timestamp && d.createdAt == request.time
    && d.authorUid == request.auth.uid;
  }
  match /advertisements/{ad} {
   allow get: if true;
   allow list: if request.query.limit != null && request.query.limit <= 20;
   allow create: if admin() && validAd();
   allow update: if false;
   allow delete: if admin();
  }
  match /{document=**} { allow read, write: if false; }
 }
}
